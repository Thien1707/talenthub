{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "locations/*.json",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true,
    "builder": "swc",
    "typeCheck": false
  }
}
