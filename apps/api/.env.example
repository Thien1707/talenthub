NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production Render: WEB_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://preview-xxx.vercel.app,http://localhost:3000
# CORS_ALLOW_VERCEL=true
# Local MySQL:
# DATABASE_URL=mysql://root:password@localhost:3306/talenthub

# Aiven MySQL (SSL bắt buộc) — thay MAT_KHAU (URL-encode nếu có ký tự đặc biệt):
# Windows dev: dùng accept_invalid_certs nếu chưa cài CA (xem certs/README.md)
DATABASE_URL=mysql://avnadmin:MAT_KHAU@mysql-91c72f0-talenthubdb-0e88.d.aivencloud.com:19052/defaultdb?sslaccept=accept_invalid_certs
# Tải CA từ Aiven → apps/api/certs/aiven-ca.pem (xem certs/README.md)
# DATABASE_SSL_CA=./certs/aiven-ca.pem
JWT_ACCESS_SECRET=thay_bang_chuoi_bi_mat_dai_32_ky_tu_tro_len
JWT_REFRESH_SECRET=thay_bang_chuoi_refresh_khac_biet
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Khuyến nghị: return qua API (cộng ví + redirect). Hoặc giữ URL frontend — trang /thanh-toan/ket-qua gọi complete-return.
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/return
# VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
# IPN cần URL HTTPS public (ngrok) — localhost VNPAY không gọi được
VNPAY_IPN_URL=https://YOUR-TUNNEL.example/api/v1/payments/vnpay/ipn
SUPER_ADMIN_EMAIL=superadmin@talenthub.local
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_123!
STAFF_SEED_EMAIL=staff@talenthub.local
STAFF_SEED_PASSWORD=ChangeMe_Staff_123!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TalentHub <noreply@example.com>
