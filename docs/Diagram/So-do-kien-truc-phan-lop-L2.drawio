<mxfile host="app.diagrams.net" agent="TalentHub-diagram-gen">
  <diagram id="0dc4296f-96d3-42e5-aba0-c289d93ae691" name="Kien truc L2">
    <mxGraphModel dx="1378" dy="872" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;align=center;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=20;" value="&lt;b&gt;TalentHub&lt;/b&gt;&amp;nbsp;&lt;b&gt;— Sơ đồ kiến trúc phân lớp&lt;/b&gt;&amp;nbsp;" vertex="1">
          <mxGeometry height="50" width="960" x="120" y="40" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4fc;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Lớp trình bày (Presentation Layer)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Màn hình (Next.js App Router):&lt;/b&gt; /viec-lam, /dang-nhap, /dang-ky, /sinh-vien/ho-so, /sinh-vien/cv, /sinh-vien/ung-tuyen, /cong-ty/tin-tuyen-dung, /staff/tin-cho-duyet, /admin/tong-quan …&lt;br&gt;&lt;b&gt;UI Components:&lt;/b&gt; auth-forms, cv-manager, notifications-bell, staff-moderation-panel …&lt;br&gt;&lt;b&gt;API client:&lt;/b&gt; src/lib/api/client.ts (axios + JWT Bearer, refresh cookie)&lt;br&gt;&lt;br&gt;&lt;i&gt;Vai trò:&lt;/i&gt; hiển thị, nhập liệu, validate format phía client; gọi REST JSON." vertex="1">
          <mxGeometry height="160" width="960" x="120" y="90" as="geometry" />
        </mxCell>
        <mxCell id="l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f8e8;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Lớp nghiệp vụ (Business / Application Layer)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;NestJS Services:&lt;/b&gt; AuthService, JobsService, JobPublishService, ApplicationsService, CvsService, ReviewsService, NotificationsService, ModerationService, PaymentsService, GeminiService (mở rộng) …&lt;br&gt;&lt;b&gt;Quy tắc:&lt;/b&gt; quota đăng tin, pipeline ApplicationStatus→HIRED, duyệt tin PENDING→APPROVED, đánh giá sau HIRED, RBAC theo UserRole.&lt;br&gt;&lt;br&gt;&lt;i&gt;Toàn bộ nghiệp vụ nằm tại lớp này — không đặt trong Controller hay Prisma query trực tiếp.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="960" x="120" y="316" as="geometry" />
        </mxCell>
        <mxCell id="l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0e8ff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Lớp truy cập dữ liệu (Data Access / Repository Layer)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Prisma ORM:&lt;/b&gt; PrismaService — truy vấn typed tới users, jobs, applications, reviews, notifications, orders …&lt;br&gt;&lt;b&gt;Module tích hợp:&lt;/b&gt; CloudinaryService (media), MailService (SMTP), VNPAY utils (mở rộng).&lt;br&gt;&lt;br&gt;&lt;i&gt;Chỉ đọc/ghi dữ liệu; không chứa quy tắc nghiệp vụ (BR-01…BR-16).&lt;/i&gt;" vertex="1">
          <mxGeometry height="122" width="960" x="120" y="528" as="geometry" />
        </mxCell>
        <mxCell id="l4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Lớp lưu trữ (Data Store Layer)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;MySQL 8.x&lt;/b&gt; — schema Prisma (~29 bảng), migration + seed (categories, super admin, pricing).&lt;br&gt;&lt;b&gt;Lưu trữ media:&lt;/b&gt; Cloudinary (CV, avatar, logo)." vertex="1">
          <mxGeometry height="96" width="960" x="120" y="731" as="geometry" />
        </mxCell>
        <mxCell id="arr1" edge="1" parent="1" source="l1" style="endArrow=block;html=1;rounded=0;strokeWidth=2;verticalAlign=middle;labelBackgroundColor=#ffffff;" target="l2" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;HTTP + JSON (REST /api/v1)&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.0015" y="101" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr2" edge="1" parent="1" source="l2" style="endArrow=block;html=1;rounded=0;strokeWidth=2;verticalAlign=middle;labelBackgroundColor=#ffffff;" target="l3" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Gọi PrismaService (repository pattern)&lt;/font&gt;">
          <mxGeometry relative="1" x="0.0308" y="123" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr3" edge="1" parent="1" source="l3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;verticalAlign=middle;labelBackgroundColor=#ffffff;" target="l4" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;SQL (Prisma Client)&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.037" y="68" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg_l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffef5;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;Mũi tên thể hiện phụ thuộc một chiều: lớp trên gọi lớp dưới; lớp dưới không gọi ngược lên UI." vertex="1">
          <mxGeometry height="80" width="460" x="120" y="851" as="geometry" />
        </mxCell>
        <mxCell id="oos_l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Ngoài phạm vi L2&lt;/b&gt;&lt;br&gt;Chi tiết WebSocket /chat, VNPAY IPN, hạ tầng deploy Render/Vercel (xem sơ đồ kiến trúc thực tế)." vertex="1">
