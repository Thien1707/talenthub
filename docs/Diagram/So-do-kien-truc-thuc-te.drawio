        <mxCell id="fn1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffef5;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Phiên đăng nhập&lt;/b&gt;&lt;br&gt;JWT access (header) + refresh HttpOnly; rotate khi POST /auth/refresh." vertex="1">
