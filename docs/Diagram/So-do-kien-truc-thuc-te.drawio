        <mxCell id="fn2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffef5;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=14;" value="&lt;b&gt;Khác SRS lý thuyết&lt;/b&gt;&lt;br&gt;4 role (thêm STAFF tách khỏi SUPER_ADMIN); tin phải APPROVED mới công khai; đánh giá sau HIRED." vertex="1">
