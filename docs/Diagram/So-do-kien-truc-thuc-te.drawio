        <mxCell id="re3" edge="1" parent="1" source="rc3" style="endArrow=block;html=1;rounded=0;strokeWidth=2;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=10;" target="rc4" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;prisma.* / Cloudinary / SMTP&lt;/font&gt;">
